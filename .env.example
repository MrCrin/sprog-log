DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000
# Optional PIN override / recovery mechanism. Normally you leave this unset
# and create a PIN in the app on first run. Setting APP_PIN makes the server
# use this PIN instead of the one stored in the database, so it can regain
# access if the in-app PIN is forgotten. Must be 4-64 characters when set.
# APP_PIN=
